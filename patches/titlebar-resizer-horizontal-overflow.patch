+import { expect, test, type Page } from "../support/fixtures";
+import { composerLocator } from "../support/helpers/composer";
+import { openAgentRoute, seedMockAgentWorkspace } from "../support/helpers/mock-agent";
+
+async function sidebarGeometry(page: Page) {
+  return page
+    .getByTestId("sidebar-settings")
+    .filter({ visible: true })
+    .evaluate((settings) => {
+      const resizeHandle = document.querySelector('[data-testid="left-sidebar-resize-handle"]');
+      const sidebar = resizeHandle?.parentElement;
+      if (!sidebar) throw new Error("Desktop sidebar is missing");
+      const rect = (element: Element) => {
+        const { x, y, width, height } = element.getBoundingClientRect();
+        return [x, y, width, height].map((value) => Math.round(value * 10) / 10);
+      };
+      return {
+        sidebar: rect(sidebar),
+        sections: Array.from(sidebar.children, rect),
+        settings: rect(settings),
+        rootScroll: [
+          document.documentElement.scrollLeft,
+          document.documentElement.scrollTop,
+          document.getElementById("root")?.scrollLeft,
+        ],
+      };
+    });
+}
+
+test("paging in the composer keeps the entire desktop sidebar in place", async ({
+  page,
+}, testInfo) => {
+  await page.setViewportSize({ width: 1280, height: 720 });
+  await page.addInitScript(() => {
+    window.paseoDesktop = {
+      platform: "win32",
+      windowChromeMode: "custom-windows",
+      events: { on: () => () => {} },
+      invoke: async (command: string) => {
+        if (command === "get_desktop_settings")
+          return {
+            releaseChannel: "stable",
+            notifications: { playSound: false },
+            daemon: { manageBuiltInDaemon: false, keepRunningAfterQuit: false },
+          };
+        return null;
+      },
+    };
+  });
+  const agent = await seedMockAgentWorkspace({
+    repoPrefix: "sidebar-composer-paging-",
+    title: "Sidebar composer paging",
+  });
+  try {
+    await openAgentRoute(page, agent);
+    const composer = composerLocator(page);
+    await expect(composer).toBeEditable();
+    for (const width of [1280, 1024, 900, 800]) {
+      await page.setViewportSize({ width, height: 720 });
+      for (const draft of [
+        "",
+        "Keep this draft",
+        "Long composer line\n".repeat(80),
+        "左右偏移".repeat(1000),
+      ]) {
+        await composer.fill(draft);
+        await expect.poll(() => sidebarGeometry(page)).toMatchObject({ rootScroll: [0, 0, 0] });
+        const before = await sidebarGeometry(page);
+        await composer.press("Control+Home");
+        for (const key of [
+          "PageDown",
+          "PageDown",
+          "PageUp",
+          "PageUp",
+          "Shift+PageDown",
+          "Shift+PageUp",
+        ]) {
+          await composer.press(key);
+          await expect
+            .poll(() => sidebarGeometry(page), { message: `${key}: ${draft.length} characters` })
+            .toEqual(before);
+          await expect(composer).toBeFocused();
+          await expect(composer).toHaveValue(draft);
+        }
+      }
+    }
+    await page.screenshot({ path: testInfo.outputPath("sidebar-after-composer-paging.png") });
+  } finally {
+    await agent.cleanup();
+  }
+});
